# Copia a .env.local si necesitas valores locales. Nunca subas .env* reales al repositorio.

# «production» solo en el build que se publica: indexable y pendientes neutros.
# Cualquier otro valor (o vacío) = preview: noindex y badges [PENDIENTE CLIENTE] amarillos.
SITE_ENV=

# IDs de terceros [PENDIENTE CLIENTE]. Solo se cargan tras el consentimiento de cookies.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
