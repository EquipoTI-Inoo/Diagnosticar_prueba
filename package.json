{
  "name": "diagnosticar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "import:content": "tsx scripts/import-content.ts && prettier --write content/*.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:datos": "tsx scripts/check-datos.ts",
    "check": "npm run check:contrast && npm run check:datos && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
