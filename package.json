{
  "name": "diagnosticar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "import:content": "tsx scripts/import-content.ts && prettier --write content/*.ts",
    "import:blog": "tsx scripts/import-blog.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "check:datos": "tsx scripts/check-datos.ts",
    "check:paginas": "tsx scripts/check-paginas.ts",
    "check": "npm run check:contrast && npm run check:datos && npm run typecheck && npm run lint",
    "check:build": "npm run build && npm run check:paginas && npm run check:seo && npm run check:schema",
    "check:redirecciones": "tsx scripts/check-redirecciones.ts",
    "docs:redirects": "tsx scripts/build-redirects-md.ts",
    "build:llms": "tsx scripts/build-llms.ts",
    "prebuild": "npm run build:llms",
    "check:schema": "tsx scripts/check-schema.ts",
    "check:seo": "tsx scripts/check-seo.ts",
    "test:e2e": "playwright test",
    "test:e2e:prod": "SITE_ENV=production npm run build && playwright test",
    "lhci": "lhci autorun",
    "lhci:prod": "SITE_ENV=production npm run build && lhci autorun"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/eslintrc": "^3.3.7",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "prettier": "^3.10.1",
    "schema-dts": "^2.1.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
